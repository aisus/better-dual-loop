{
  "name": "better-dual-loop",
  "private": true,
  "description": "Unofficial firmware mod for the NUX Dual Loop Stereo (NML-3DLS) looper: the page that makes it",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
