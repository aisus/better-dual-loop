    "dev": "vite",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
